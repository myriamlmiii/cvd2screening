# Copy to .env and fill in. Nothing here is read unless DRY_RUN is turned off
# or you actually run a source/sink that needs it.

# --- LLM (Groq only) ---
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_SCORING_MODEL=llama-3.3-70b-versatile

# --- Airtable (single source of truth) ---
# Personal Access Token with scope data.records:read (data.records:write too
# if you want write-back) and access to the SITUATIONS base.
# Create at https://airtable.com/create/tokens
AIRTABLE_API_KEY=
# Defaults to the real SITUATIONS base if left blank (see config.py).
AIRTABLE_BASE_ID=appb9A3NOEb76UQaJ
# Only used for write-back (AirtableSink), not for reading PIPELINE.
AIRTABLE_TABLE_NAME=Deals

# --- Supabase (optional — dashboard read model for scored deals) ---
# Create a free project at https://supabase.com, run supabase/schema.sql
# against it (SQL editor), then paste the values from
# Project Settings -> API here. Use the SERVICE ROLE key here (backend,
# write access) — the frontend uses the anon key instead, see
# ../.env.local.example.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Behaviour ---
# DRY_RUN=true  -> never write to Airtable, just print + cache locally
DRY_RUN=true
DATA_DIR=./data
# Where the dashboard reads its snapshot from
SNAPSHOT_PATH=./data/deals.json
