# n8n → POST /api/webhooks/intake | /api/sync/airtable | /api/sync/drive
# INTAKE_WEBHOOK_SECRET=
# SYNC_WEBHOOK_SECRET=

# Comma-separated Drive folder IDs — one per intake root (e.g. one per year folder).
GOOGLE_DRIVE_FOLDER_IDS=
# Full service-account JSON key from Google Cloud Console, pasted as one line.
# Share each Drive folder with the key's client_email — no OAuth, no login, no expiry.
GOOGLE_SERVICE_ACCOUNT_KEY=

# Background Drive sync (n8n or Vercel Cron). Users never use this to log into the CRM.
# CRON_SECRET=

# CRM login allowlist.
ALLOWED_EMAILS=lmeriem28@gmail.com,dlaraki@u-investors.com,j.lobe@u-investors.com

