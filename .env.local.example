# Copy to .env.local to serve live Airtable data.
# Without this file the app runs from data/airtable-snapshot.json.

# Personal Access Token with scope: data.records:read
# Create at https://airtable.com/create/tokens (add the SITUATIONS base)
AIRTABLE_TOKEN=

# Optional — defaults to the SITUATIONS base
# AIRTABLE_BASE_ID=appb9A3NOEb76UQaJ

# --- Supabase (optional — AI scores for the Screening views) ---
# Without these, /screening/* renders real Airtable data with every score
# blank. Create a project at https://supabase.com, run supabase/schema.sql
# against it, then paste Project Settings -> API values here. Use the ANON
# key here (read-only) — the backend pipeline uses the service role key
# instead, see backend/.env.example.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Service-role key — server-only, powers the Priority board's decision writes
# (app/api/decisions/route.ts). Bypasses RLS. Never expose this to the
# browser, never commit it. Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Same URL/anon key as above, re-exposed with the NEXT_PUBLIC_ prefix so the
# browser can open a realtime subscription to scored_deals (read-only,
# already public-select — see supabase/schema.sql). Without these two, the
# app works exactly as before, it just doesn't live-refresh.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Groq — screening memos (app/api/recommend/route.ts). Server-only.
# https://console.groq.com/keys
GROQ_API_KEY=

# Optional: AUTH_REQUIRED=false keeps the CRM open without login.
AUTH_REQUIRED=true
DEMO_EMAIL=investors123@gmail.com
DEMO_PASSWORD=12345@
# CRM team logins (shared DEMO_PASSWORD). Meriem is always allowed.
ALLOWED_EMAILS=lmeriem28@gmail.com,dlaraki@u-investors.com,j.lobe@u-investors.com
# AUTH_SECRET=change-me-before-production

# Optional: require a Supabase auth cookie (see middleware.ts)
# AUTH_REQUIRED=true

# n8n → POST /api/webhooks/intake | /api/sync/airtable | /api/sync/drive with header x-intake-secret
# INTAKE_WEBHOOK_SECRET=
# SYNC_WEBHOOK_SECRET=

# Google Drive incremental ingest (server-only service account). Never expose in the browser.
# Create a service account in Google Cloud Console, download its JSON key, paste the
# whole file here as one line, then share each target Drive folder with its client_email
# (Viewer access). No OAuth consent, no refresh token, no expiry.
# One root per intake year (or however the folders are split) — comma-separated.
# GOOGLE_DRIVE_FOLDER_IDS=
# GOOGLE_SERVICE_ACCOUNT_KEY=

# Higgsfield — optional 3D brand stills (`npm run brand:generate`)
# https://cloud.higgsfield.ai — Key id + secret, server-only
# HF_API_KEY_ID=
# HF_API_KEY_SECRET=

# APP_ROLE=Reviewer

# Optional — Sentry (omit = no-op, app still boots)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# Optional — Upstash rate limit for Groq routes (omit = unlimited locally)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

